      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Perito123*",
          "temporary": false
        }
      ],
      "realmRoles": ["PERITO"]
    },
    {
      "username": "actuario@aegiscore.com",
      "email": "actuario@aegiscore.com",
      "firstName": "Mariana",
      "lastName": "Vargas",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
