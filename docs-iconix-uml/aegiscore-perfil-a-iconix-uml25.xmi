<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1">
  <xmi:Documentation exporter="AegisCore_AI_UML_Engine" exporterVersion="17.0" />
  <uml:Model xmi:type="uml:Model" xmi:id="EA_Model_AegisCore_PerfilA" name="AegisCore_AI_Perfil_A">

    <!-- PAQUETE 1: METODOLOGÍA ICONIX - OBJETOS ROBUSTEZ BCE (CU01 AL CU05 + SAGA CU09) -->
    <packagedElement xmi:type="uml:Package" xmi:id="PKG_ICONIX_Robustez_Perfil_A" name="01_ICONIX_Robustness_Perfil_A">

      <!-- CU01: Iniciar Sesión Único Multi-Aplicación (SSO) y Control de Roles -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_CU01" name="CU01_SingleSignOn_Keycloak_OIDC_PKCE">
        <packagedElement xmi:type="uml:Class" xmi:id="B_LoginUnificadoSSOView" name="LoginUnificadoSSOView">
          <ownedOperation xmi:id="op_b_sso_1" name="iniciarLoginFederadoOIDC" />
          <ownedOperation xmi:id="op_b_sso_2" name="generarParPKCE_S256" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_AuthOIDCController" name="AuthOIDCController">
          <ownedOperation xmi:id="op_c_sso_1" name="autenticarUsuarioOIDC" />
          <ownedOperation xmi:id="op_c_sso_2" name="validarTokenJwtRS256" />
          <ownedOperation xmi:id="op_c_sso_3" name="registrarSesionUnificadaDynamoDB" />
          <ownedOperation xmi:id="op_c_sso_4" name="sincronizarUsuarioRolPostgreSQL" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="E_UsuarioRol" name="UsuarioRol">
          <ownedAttribute xmi:id="att_usr_1" name="id" type="UUID" />
          <ownedAttribute xmi:id="att_usr_2" name="keycloakSub" type="String" />
          <ownedAttribute xmi:id="att_usr_3" name="email" type="String" />
          <ownedAttribute xmi:id="att_usr_4" name="rol" type="RolSSO" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="E_SesionUnificadaToken" name="SesionUnificadaToken">
          <ownedAttribute xmi:id="att_ses_1" name="session_id" type="String" />
          <ownedAttribute xmi:id="att_ses_2" name="keycloak_sub" type="String" />
          <ownedAttribute xmi:id="att_ses_3" name="jwt_signature_hash" type="SHA256" />
          <ownedAttribute xmi:id="att_ses_4" name="ttl" type="Long" />
        </packagedElement>
      </packagedElement>

      <!-- CU02: Consultar Estado Unificado de Pólizas, Vehículos y Siniestros (Federación GraphQL) -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_CU02" name="CU02_EstadoUnificado_GraphQL_Federation">
        <packagedElement xmi:type="uml:Class" xmi:id="B_ResumenCoberturaClienteView" name="ResumenCoberturaClienteView">
          <ownedOperation xmi:id="op_b_res_1" name="abrirDashboardAsegurado" />
          <ownedOperation xmi:id="op_b_res_2" name="inspeccionarQuerySupergraph" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_ApolloFederationResolver" name="ApolloFederationResolver">
          <ownedOperation xmi:id="op_c_fed_1" name="resolverResumenUnificadoAsegurado" />
          <ownedOperation xmi:id="op_c_fed_2" name="consultarOActualizarCacheCoberturaActiva" />
          <ownedOperation xmi:id="op_c_fed_3" name="federarExpedientesSiniestrosMongoDB" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="E_CacheCoberturaActiva" name="CacheCoberturaActiva">
          <ownedAttribute xmi:id="att_cac_1" name="cliente_id" type="UUID" />
          <ownedAttribute xmi:id="att_cac_2" name="total_saldo_cobertura" type="Decimal" />
          <ownedAttribute xmi:id="att_cac_3" name="updated_at" type="DateTime" />
        </packagedElement>
      </packagedElement>

      <!-- CU03: Gestionar Catálogo de Planes de Seguro, Coberturas (FK) y Clientes -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_CU03" name="CU03_CatalogoPlanes_CoberturasFK_Clientes_DDD">
        <packagedElement xmi:type="uml:Class" xmi:id="B_GestionCatalogoSegurosView" name="GestionCatalogoSegurosView">
          <ownedOperation xmi:id="op_b_cat_1" name="enviarFormularioNuevoPlan" />
          <ownedOperation xmi:id="op_b_cat_2" name="enviarFormularioNuevoCliente" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_CatalogoPolizaApplicationService" name="CatalogoPolizaApplicationService">
          <ownedOperation xmi:id="op_c_cat_1" name="listarPlanesSeguro" />
          <ownedOperation xmi:id="op_c_cat_2" name="registrarPlanSeguroDDD" />
          <ownedOperation xmi:id="op_c_cat_3" name="agregarCoberturaAPlan" />
          <ownedOperation xmi:id="op_c_cat_4" name="registrarClienteDDD" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="E_PlanSeguro" name="PlanSeguro">
          <ownedAttribute xmi:id="att_pln_1" name="id" type="UUID" />
          <ownedAttribute xmi:id="att_pln_2" name="codigo" type="String" />
          <ownedAttribute xmi:id="att_pln_3" name="nombre" type="String" />
          <ownedAttribute xmi:id="att_pln_4" name="primaBaseAnual" type="Decimal" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="E_Cobertura" name="Cobertura">
          <ownedAttribute xmi:id="att_cob_1" name="id" type="UUID" />
          <ownedAttribute xmi:id="att_cob_2" name="planId" type="UUID_FK" />
          <ownedAttribute xmi:id="att_cob_3" name="codigo" type="String" />
          <ownedAttribute xmi:id="att_cob_4" name="sumaAseguradaMax" type="Decimal" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="E_Cliente" name="Cliente">
          <ownedAttribute xmi:id="att_cli_1" name="id" type="UUID" />
          <ownedAttribute xmi:id="att_cli_2" name="numeroDocumento" type="String" />
          <ownedAttribute xmi:id="att_cli_3" name="nombreCompleto" type="String" />
          <ownedAttribute xmi:id="att_cli_4" name="scoreCrediticio" type="Integer" />
        </packagedElement>
      </packagedElement>

      <!-- CU04: Cotizar y Emitir Póliza en Línea con Validación de Documentos por IA Local Web -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_CU04" name="CU04_CotizacionEmision_IALocalWeb_ONNX_TFJS">
        <packagedElement xmi:type="uml:Class" xmi:id="B_CotizadorInscripcionWebView" name="CotizadorInscripcionWebView">
          <ownedOperation xmi:id="op_b_cot_1" name="ingresarDatosVehiculoYAdjuntarDocumento" />
          <ownedOperation xmi:id="op_b_cot_2" name="confirmarEmisionPoliza" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_ValidadorNitidezLocalWebControl" name="ValidadorNitidezLocalWebControl">
          <ownedOperation xmi:id="op_c_iaw_1" name="validarNitidez" />
          <ownedOperation xmi:id="op_c_iaw_2" name="generarTensorSimulado" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_EmisionPolizaGraphQLController" name="EmisionPolizaGraphQLController">
          <ownedOperation xmi:id="op_c_emi_1" name="cotizarPolizaEnLinea" />
          <ownedOperation xmi:id="op_c_emi_2" name="validarNitidez" />
          <ownedOperation xmi:id="op_c_emi_3" name="insertarPoliza" />
          <ownedOperation xmi:id="op_c_emi_4" name="emitirPoliza" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="E_Poliza" name="Poliza">
          <ownedAttribute xmi:id="att_pol_1" name="id" type="UUID" />
          <ownedAttribute xmi:id="att_pol_2" name="numeroPoliza" type="String" />
          <ownedAttribute xmi:id="att_pol_3" name="primaAnual" type="Decimal" />
          <ownedAttribute xmi:id="att_pol_4" name="saldoCoberturaRestante" type="Decimal" />
          <ownedOperation xmi:id="op_e_pol_1" name="descontarTechoAnualPoliza" />
          <ownedOperation xmi:id="op_e_pol_2" name="compensarCoberturaSaga" />
        </packagedElement>
      </packagedElement>

      <!-- CU05: Contratar o Renovar Póliza por WhatsApp y Emitir Factura PDF con n8n -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_CU05" name="CU05_PedidoWhatsApp_n8n_FacturaPDF">
        <packagedElement xmi:type="uml:Class" xmi:id="B_BotConversacionalWhatsAppPoliza" name="BotConversacionalWhatsAppPoliza">
          <ownedOperation xmi:id="op_b_wa_1" name="enviarSolicitudPolizaWhatsApp" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_WebhookTriggerN8N" name="WebhookTriggerN8N">
          <ownedOperation xmi:id="op_c_n8n_1" name="dispararWebhookContratacion" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_RecepcionPedidoService" name="RecepcionPedidoService">
          <ownedOperation xmi:id="op_c_ped_1" name="procesarPedidoPolizaWhatsApp" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_FacturacionService" name="FacturacionService">
          <ownedOperation xmi:id="op_c_fac_1" name="generarFacturaNotaVentaPDF" />
          <ownedOperation xmi:id="op_c_fac_2" name="obtenerBinarioPdfFactura" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="E_FacturaNotaVenta" name="FacturaNotaVenta">
          <ownedAttribute xmi:id="att_fac_1" name="id" type="UUID" />
          <ownedAttribute xmi:id="att_fac_2" name="numeroFactura" type="String" />
          <ownedAttribute xmi:id="att_fac_3" name="total" type="Decimal" />
          <ownedAttribute xmi:id="att_fac_4" name="hashDigitalSha256" type="SHA256" />
        </packagedElement>
      </packagedElement>

    </packagedElement>
  </uml:Model>
</xmi:XMI>

