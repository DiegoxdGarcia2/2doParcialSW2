<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1">
  <xmi:Documentation exporter="AegisCore_AI_UML_Engine" exporterVersion="17.0" />
  <uml:Model xmi:type="uml:Model" xmi:id="EA_Model_AegisCore_PerfilB" name="AegisCore_AI_Perfil_B">
    
    <!-- PAQUETE 1: METODOLOGÍA ICONIX - OBJETOS ROBUSTEZ BCE (CU06 AL CU10) -->
    <packagedElement xmi:type="uml:Package" xmi:id="PKG_ICONIX_Robustez_Perfil_B" name="01_ICONIX_Robustness_Perfil_B">
      
      <!-- CU06: Siniestro Emergencia WhatsApp + Triaje IA -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_CU06" name="CU06_SiniestroEmergencia_AppMovil_Triaje">
        <packagedElement xmi:type="uml:Class" xmi:id="B_ReporteSiniestroMovilView" name="ReporteSiniestroMovilView">
          <ownedOperation xmi:id="op_b_sos_1" name="capturarFotosYCoordenadasGPS" />
          <ownedOperation xmi:id="op_b_sos_2" name="presionarBotonEmergenciaSOS" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="B_PushNotificationFCMBoundary" name="PushNotificationFCMBoundary">
          <ownedOperation xmi:id="op_b_fcm_1" name="despacharNotificacionPeritoMasCercano" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_RegistrarSiniestroEmergenciaUseCase" name="RegistrarSiniestroEmergenciaUseCase">
          <ownedOperation xmi:id="op_c_ms2_1" name="registrarSiniestroEmergencia" />
          <ownedOperation xmi:id="op_c_ms2_2" name="mapearExpedienteConGeoJSON" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_EvaluarSeveridadDanoService" name="EvaluarSeveridadDanoService">
          <ownedOperation xmi:id="op_c_ia_1" name="evaluarSeveridadImagen" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="E_ExpedienteSiniestroDocument" name="ExpedienteSiniestroDocument">
          <ownedAttribute xmi:id="att_exp_1" name="idExpediente" type="String" />
          <ownedAttribute xmi:id="att_exp_2" name="coordenadasGPS_2dsphere" type="GeoJSON" />
          <ownedAttribute xmi:id="att_exp_3" name="estado" type="String" />
          <ownedAttribute xmi:id="att_exp_4" name="severidadEvaluada" type="String" />
        </packagedElement>
      </packagedElement>

      <!-- CU07: Inspeccionar Daños Offline Móvil con Agente TFLite -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_CU07" name="CU07_InspeccionOffline_AgenteTFLite">
        <packagedElement xmi:type="uml:Class" xmi:id="B_CamaraInspeccionFlutterView" name="CamaraInspeccionFlutterView">
          <ownedOperation xmi:id="op_b_cam_1" name="capturarFotografia" />
          <ownedOperation xmi:id="op_b_cam_2" name="renderizarGuiasVisuales" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="B_SensorGpsHardwareBoundary" name="SensorGpsHardwareBoundary">
          <ownedOperation xmi:id="op_b_gps_1" name="capturarCoordenadasActuales" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_AgentePericialLocalTFLiteControl" name="AgentePericialLocalTFLiteControl">
          <ownedOperation xmi:id="op_c_tfl_1" name="analizarFotografiaEnDispositivo" />
          <ownedOperation xmi:id="op_c_tfl_2" name="inferirModeloConTensoresTFLite" />
          <ownedOperation xmi:id="op_c_tfl_3" name="verificarAnguloYCalidadFotografica" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_InspeccionLocalManagerControl" name="InspeccionLocalManagerControl">
          <ownedOperation xmi:id="op_c_mgr_1" name="almacenarInspeccionOffline" />
          <ownedOperation xmi:id="op_c_mgr_2" name="generarUUIDv4IdempotencyKey" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="E_InspeccionOfflineSQLiteEntity" name="InspeccionOfflineSQLiteEntity">
          <ownedAttribute xmi:id="att_sql_1" name="localId" type="Integer" />
          <ownedAttribute xmi:id="att_sql_2" name="idempotencyKey" type="UUIDv4" />
          <ownedAttribute xmi:id="att_sql_3" name="fotosBlobPaths" type="String" />
          <ownedAttribute xmi:id="att_sql_4" name="syncStatus" type="String" />
        </packagedElement>
      </packagedElement>

      <!-- CU08: Sincronizar Expediente de Siniestro con Control de Idempotencia -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_CU08" name="CU08_Sincronizacion_Idempotencia_DynamoDB">
        <packagedElement xmi:type="uml:Class" xmi:id="B_SyncBackgroundWorker" name="SyncBackgroundWorker">
          <ownedOperation xmi:id="op_b_sync_1" name="ejecutarSincronizacionLote" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_IdempotencyGuardInterceptor" name="IdempotencyGuardInterceptor">
          <ownedOperation xmi:id="op_c_idm_1" name="interceptarPeticionHttp" />
          <ownedOperation xmi:id="op_c_idm_2" name="calcularHashSHA256" />
          <ownedOperation xmi:id="op_c_idm_3" name="verificarYAdquirirBloqueo" />
          <ownedOperation xmi:id="op_c_idm_4" name="guardarRespuestaCompletada" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_SincronizarPeritajeUseCase" name="SincronizarPeritajeUseCase">
          <ownedOperation xmi:id="op_c_sync_1" name="ejecutarSincronizacion" />
          <ownedOperation xmi:id="op_c_sync_2" name="validarConsistenciaExpediente" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="E_IdempotencyRecord" name="IdempotencyRecord">
          <ownedAttribute xmi:id="att_idm_1" name="idempotency_key" type="UUIDv4" />
          <ownedAttribute xmi:id="att_idm_2" name="payload_hash" type="SHA256" />
          <ownedAttribute xmi:id="att_idm_3" name="status" type="String" />
          <ownedAttribute xmi:id="att_idm_4" name="response_body_cached" type="JSON" />
          <ownedAttribute xmi:id="att_idm_5" name="ttl" type="Long" />
        </packagedElement>
      </packagedElement>

      <!-- CU09: Liquidar y Pagar Indemnización de Siniestro (Saga en 3 MS) -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_CU09" name="CU09_Saga_Liquidacion_3MS_Compensacion">
        <packagedElement xmi:type="uml:Class" xmi:id="B_LiquidacionAdminView" name="LiquidacionAdminView">
          <ownedOperation xmi:id="op_b_liq_1" name="mostrarFormularioAprobacion" />
          <ownedOperation xmi:id="op_b_liq_2" name="solicitarAprobacionLiquidacion" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_SagaLiquidacionOrchestrator" name="SagaLiquidacionOrchestrator">
          <ownedOperation xmi:id="op_c_saga_1" name="iniciarSagaLiquidacion" />
          <ownedOperation xmi:id="op_c_saga_2" name="procesarPaso1BloqueoReclamoMS2" />
          <ownedOperation xmi:id="op_c_saga_3" name="procesarPaso2DescuentoCoberturaMS1" />
          <ownedOperation xmi:id="op_c_saga_4" name="procesarPaso3DesembolsoActuarialMS3" />
          <ownedOperation xmi:id="op_c_saga_5" name="ejecutarCompensacionRollback" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_ReclamoEstadoUseCase" name="ReclamoEstadoUseCase">
          <ownedOperation xmi:id="op_c_rec_1" name="actualizarEstadoReclamo" />
          <ownedOperation xmi:id="op_c_rec_2" name="revertirEstadoObservadoFinanzas" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_PolizaCoverageService" name="PolizaCoverageService">
          <ownedOperation xmi:id="op_c_pol_1" name="descontarTechoAnualPoliza" />
          <ownedOperation xmi:id="op_c_pol_2" name="restituirSaldoCobertura" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_WorkflowNotificacionSagaN8N" name="WorkflowNotificacionSagaN8N">
          <ownedOperation xmi:id="op_c_n8n_1" name="consumirEventoKafkaSaga" />
          <ownedOperation xmi:id="op_c_n8n_2" name="enviarCorreoComprobanteIndemnizacion" />
          <ownedOperation xmi:id="op_c_n8n_3" name="despacharAlertaAuditoriaYCompensacion" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="E_OrdenLiquidacion" name="OrdenLiquidacion">
          <ownedAttribute xmi:id="att_ord_1" name="idOrdenLiquidacion" type="UUIDv4" />
          <ownedAttribute xmi:id="att_ord_2" name="montoIndemnizado" type="BigDecimal" />
          <ownedAttribute xmi:id="att_ord_3" name="deducible" type="BigDecimal" />
          <ownedAttribute xmi:id="att_ord_4" name="montoNetoDesembolsado" type="BigDecimal" />
          <ownedAttribute xmi:id="att_ord_5" name="estadoSaga" type="String" />
        </packagedElement>
      </packagedElement>

      <!-- CU10: Procesar Cobro Recurrente de Primas y Pago QR Idempotente -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_CU10" name="CU10_CobranzaPrima_PagoQR_Hexagonal">
        <packagedElement xmi:type="uml:Class" xmi:id="B_PasarelaPagoQRView" name="PasarelaPagoQRView">
          <ownedOperation xmi:id="op_b_qr_1" name="generarCodigoQRPago" />
          <ownedOperation xmi:id="op_b_qr_2" name="confirmarPagoQR" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_CobranzaPrimaQRUseCasePort" name="CobranzaPrimaQRUseCasePort">
          <ownedOperation xmi:id="op_c_qr_1" name="procesarCobroPrimaQR" />
          <ownedOperation xmi:id="op_c_qr_2" name="calcularReglaActuarialYComision" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="C_IdempotencyLockPaymentControl" name="IdempotencyLockPaymentControl">
          <ownedOperation xmi:id="op_c_lck_1" name="adquirirBloqueoTransaccional" />
          <ownedOperation xmi:id="op_c_lck_2" name="liberarBloqueoConExito" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="E_PagoPrimaTransaccion" name="PagoPrimaTransaccion">
          <ownedAttribute xmi:id="att_pg_1" name="idPago" type="UUIDv4" />
          <ownedAttribute xmi:id="att_pg_2" name="montoPrima" type="BigDecimal" />
          <ownedAttribute xmi:id="att_pg_3" name="numeroRecibo" type="String" />
          <ownedAttribute xmi:id="att_pg_4" name="fechaPago" type="Timestamp" />
        </packagedElement>
      </packagedElement>

    </packagedElement>

    <!-- ESTEREOTIPOS ICONIX PARA ENTERPRISE ARCHITECT 17 -->
    <packagedElement xmi:type="uml:Profile" xmi:id="Profile_ICONIX" name="ICONIX_Profile">
      <packagedElement xmi:type="uml:Stereotype" xmi:id="stereo_boundary" name="boundary" />
      <packagedElement xmi:type="uml:Stereotype" xmi:id="stereo_control" name="control" />
      <packagedElement xmi:type="uml:Stereotype" xmi:id="stereo_entity" name="entity" />
    </packagedElement>

  </uml:Model>
</xmi:XMI>
