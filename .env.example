# =============================================================================
#  AEGISCORE AI - Plantilla de Variables de Entorno (Persistencia Cloud)
# =============================================================================

# 1. Neon Serverless PostgreSQL (MS1 PHP DDD, MS3 Spring Boot, MS4 Python)
DATABASE_URL="postgresql://<user>:<password>@<neon-host>/neondb?sslmode=require&channel_binding=require"
DB_CONNECTION=pgsql
DB_HOST=ep-damp-salad-b5enofaj-pooler.c-7.us-east-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password
DB_SSLMODE=require

# Spring Boot Datasource (MS3 Actuarial)
SPRING_DATASOURCE_URL="jdbc:postgresql://<neon-host>:5432/neondb?sslmode=require"
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password

# 2. MongoDB Atlas Cloud (MS2 NestJS Clean Arch, MS4 Python)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aegiscore_siniestros_db?retryWrites=true&w=majority"
MONGO_INITDB_DATABASE="aegiscore_siniestros_db"
MONGO_DB="aegiscore_siniestros_db"

# 3. Amazon DynamoDB Cloud (us-east-2) (Idempotencia Transversal CU08, CU10)
AWS_REGION="us-east-2"
AWS_DEFAULT_REGION="us-east-2"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
DYNAMODB_TABLE_IDEMPOTENCY="AegisCore_IdempotencyRecords"

# 4. Servicios Transversales (Keycloak SSO, Kafka, n8n)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=Admin123*
KAFKA_PORT=9092
N8N_PORT=5678

# 5. Microservicios Ports
MS1_PORT=8001
MS2_PORT=8002
MS3_PORT=8003
MS4_PORT=8004
