# =============================================================================
#  AegisCore AI - .gitignore
# =============================================================================

# Scripts de setup y scaffolding inicial (uso local único)
setup-workspace.ps1
setup-workspace.sh

# Variables de entorno y secretos activos (usar .env.example como plantilla)
.env
/env
.env.local
.env.*.local
*.pem
*.key

# Reportes compilados efímeros generados en caliente (CU15)
backend/ms4-ia-mcp-python/artifacts/reports/*
!backend/ms4-ia-mcp-python/artifacts/reports/.gitkeep

# Archivos del Sistema Operativo
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# IDEs y Editores
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Node.js & JavaScript / TypeScript (MS2 NestJS, React, Angular)
node_modules/
dist/
build/
.npm
.yarn/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.next/
.nuxt/
coverage/
.nyc_output/

# PHP / Composer (MS1 Laravel / DDD)
vendor/
composer.phar
.phpunit.result.cache
.php-cs-fixer.cache

# Java / Maven / Gradle (MS3 Spring Boot Hexagonal)
target/
*.class
*.jar
*.war
*.ear
*.nar
.gradle/
build/
out/
.settings/
.project
.classpath

# Python / FastAPI / Machine Learning (MS4 IA & MCP)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# Bases de Datos Locales y Archivos Temporales de Ejecución
*.log
*.sqlite
*.sqlite3
*.db
dynamodb_data/
mongo_data/
postgres_data/

# Archivos Temporales y Scratch
tmp/
temp/
scratch/
